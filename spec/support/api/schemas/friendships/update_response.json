{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["success"],
  "properties": {
    "success": { "type": "boolean", "enum": [true] },
    "friendship": { "$ref": "#/definitions/friendship" }
  },
  "definitions": {
    "friendship": {
      "type": "object",
      "required": ["id", "status", "requested_by_id", "user_a", "user_b", "created_at", "updated_at"],
      "properties": {
        "id":               { "type": "integer" },
        "status":           { "type": "string" },
        "requested_by_id":  { "type": "integer" },
        "user_a":           { "$ref": "#/definitions/user" },
        "user_b":           { "$ref": "#/definitions/user" },
        "created_at":       { "type": "string" },
        "updated_at":       { "type": "string" }
      }
    },
    "user": {
      "type": "object",
      "required": ["id", "full_name", "email"],
      "properties": {
        "id":        { "type": "integer" },
        "full_name": { "type": "string" },
        "email":     { "type": "string" }
      }
    }
  }
}
