{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["success", "friendship"],
  "properties": {
    "success":    { "type": "boolean", "enum": [true] },
    "friendship": { "$ref": "#/definitions/friendship_ledger" }
  },
  "definitions": {
    "friendship_ledger": {
      "type": "object",
      "required": ["id", "status", "requested_by_id", "friend", "balance_summary", "group_balances", "transactions", "created_at", "updated_at"],
      "properties": {
        "id":              { "type": "integer" },
        "status":          { "type": "string" },
        "requested_by_id": { "type": "integer" },
        "created_at":      { "type": "string" },
        "updated_at":      { "type": "string" },
        "friend":          { "$ref": "#/definitions/friend_user" },
        "balance_summary": { "$ref": "#/definitions/balance" },
        "group_balances":  { "type": "array", "items": { "$ref": "#/definitions/group_balance" } },
        "transactions":    { "type": "array", "items": { "$ref": "#/definitions/transaction" } }
      }
    },
    "friend_user": {
      "type": "object",
      "required": ["id", "full_name", "email"],
      "properties": {
        "id":        { "type": "integer" },
        "full_name": { "type": "string" },
        "email":     { "type": "string" }
      }
    },
    "balance": {
      "type": "object",
      "required": ["type", "amount_cents"],
      "properties": {
        "type":         { "type": "string", "enum": ["owes_you", "you_owe", "settled_up"] },
        "amount_cents": { "type": "integer" }
      }
    },
    "group_balance": {
      "type": "object",
      "required": ["group_id", "group_name", "balance"],
      "properties": {
        "group_id":   { "type": "integer" },
        "group_name": { "type": "string" },
        "balance":    { "$ref": "#/definitions/balance" }
      }
    },
    "transaction": {
      "type": "object",
      "required": ["id", "type", "visibility", "title", "note", "date", "currency", "amount_cents",
                   "render_as", "viewer_role", "summary", "paid_by", "account",
                   "transfer_to_account", "category", "counterpart", "split_method", "splits"],
      "properties": {
        "id":                  { "type": "integer" },
        "type":                { "type": "string", "enum": ["expense", "income", "transfer", "settlement"] },
        "visibility":          { "type": "string", "enum": ["personal", "shared"] },
        "title":               { "type": "string" },
        "note":                { "type": ["string", "null"] },
        "date":                { "type": "string" },
        "currency":            { "$ref": "#/definitions/currency_ref" },
        "amount_cents":        { "type": "integer" },
        "render_as":           { "type": "string", "enum": ["personal_expense", "personal_income", "transfer", "shared_expense_payer", "shared_expense_participant", "settlement_settler", "settlement_settlee"] },
        "viewer_role":         { "type": "string", "enum": ["owner", "payer", "participant", "settler", "settlee"] },
        "summary":             { "$ref": "#/definitions/summary" },
        "paid_by":             { "$ref": "#/definitions/user_with_is_you" },
        "account":             { "$ref": "#/definitions/account_ref" },
        "transfer_to_account": { "oneOf": [{ "$ref": "#/definitions/account_ref" }, { "type": "null" }] },
        "category":            { "oneOf": [{ "$ref": "#/definitions/category_ref" }, { "type": "null" }] },
        "counterpart":         { "oneOf": [{ "$ref": "#/definitions/user_ref" }, { "type": "null" }] },
        "split_method":        { "type": ["string", "null"] },
        "splits":              { "oneOf": [{ "type": "array", "items": { "$ref": "#/definitions/split" } }, { "type": "null" }] }
      }
    },
    "summary": {
      "type": "object",
      "required": ["label", "amount_cents", "paid_by_label"],
      "properties": {
        "label":         { "type": "string" },
        "amount_cents":  { "type": "integer" },
        "paid_by_label": { "type": "string" }
      }
    },
    "currency_ref": {
      "type": "object",
      "required": ["code", "symbol"],
      "properties": {
        "code":   { "type": "string" },
        "symbol": { "type": "string" }
      }
    },
    "account_ref": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id":   { "type": "integer" },
        "name": { "type": "string" }
      }
    },
    "category_ref": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id":   { "type": "integer" },
        "name": { "type": "string" }
      }
    },
    "user_ref": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id":   { "type": "integer" },
        "name": { "type": "string" }
      }
    },
    "user_with_is_you": {
      "type": "object",
      "required": ["id", "name", "is_you"],
      "properties": {
        "id":     { "type": "integer" },
        "name":   { "type": "string" },
        "is_you": { "type": "boolean" }
      }
    },
    "split": {
      "type": "object",
      "required": ["user", "owed_amount_cents", "allocation_value", "category"],
      "properties": {
        "user":              { "$ref": "#/definitions/user_with_is_you" },
        "owed_amount_cents": { "type": "integer" },
        "allocation_value":  { "type": ["number", "null"] },
        "category":          { "oneOf": [{ "$ref": "#/definitions/category_ref" }, { "type": "null" }] }
      }
    }
  }
}
