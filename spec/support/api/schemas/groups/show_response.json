{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["success", "group"],
  "properties": {
    "success": { "type": "boolean", "enum": [true] },
    "group": { "$ref": "#/definitions/group" }
  },
  "definitions": {
    "group": {
      "type": "object",
      "required": ["id", "name", "created_by_id", "members", "transactions", "created_at", "updated_at"],
      "properties": {
        "id":            { "type": "integer" },
        "name":          { "type": "string" },
        "description":   { "type": ["string", "null"] },
        "created_by_id": { "type": "integer" },
        "members": {
          "type": "array",
          "items": { "$ref": "#/definitions/member" }
        },
        "transactions": {
          "type": "array",
          "items": { "$ref": "#/definitions/transaction" }
        },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    },
    "member": {
      "type": "object",
      "required": ["id", "full_name", "email"],
      "properties": {
        "id":        { "type": "integer" },
        "full_name": { "type": "string" },
        "email":     { "type": "string" }
      }
    },
    "transaction": {
      "type": "object",
      "required": ["id", "title", "amount_cents", "transaction_type", "visibility_type", "transaction_date", "user_id", "created_at", "updated_at"],
      "properties": {
        "id":                  { "type": "integer" },
        "title":               { "type": "string" },
        "amount_cents":        { "type": "integer" },
        "transaction_type":    { "type": "string" },
        "visibility_type":     { "type": "string" },
        "transaction_date":    { "type": "string" },
        "note":                { "type": ["string", "null"] },
        "account_id":          { "type": "integer" },
        "transfer_account_id": { "type": ["integer", "null"] },
        "category_id":         { "type": ["integer", "null"] },
        "currency_id":         { "type": "integer" },
        "user_id":             { "type": "integer" },
        "created_at":          { "type": "string" },
        "updated_at":          { "type": "string" }
      }
    }
  }
}
