{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["success", "report"],
  "properties": {
    "success": { "type": "boolean", "enum": [true] },
    "report":  { "$ref": "#/definitions/report" }
  },
  "definitions": {
    "report": {
      "type": "object",
      "required": ["period", "overview", "accounts", "total_balance_cents", "spending_by_category", "shared_money", "trend"],
      "properties": {
        "period": { "type": "string" },
        "overview": { "$ref": "#/definitions/overview" },
        "accounts": {
          "type": "array",
          "items": { "$ref": "#/definitions/account" }
        },
        "total_balance_cents": { "type": "integer" },
        "spending_by_category": {
          "type": "array",
          "items": { "$ref": "#/definitions/category_spending" }
        },
        "shared_money": { "$ref": "#/definitions/shared_money" },
        "trend": {
          "type": "array",
          "items": { "$ref": "#/definitions/trend_month" },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "overview": {
      "type": "object",
      "required": ["total_income_cents", "total_expenses_cents", "net_cents", "savings_rate_percent"],
      "properties": {
        "total_income_cents":   { "type": "integer" },
        "total_expenses_cents": { "type": "integer" },
        "net_cents":            { "type": "integer" },
        "savings_rate_percent": { "type": "integer" }
      }
    },
    "account": {
      "type": "object",
      "required": ["id", "name", "balance_cents", "currency_code"],
      "properties": {
        "id":            { "type": "integer" },
        "name":          { "type": "string" },
        "balance_cents": { "type": "integer" },
        "currency_code": { "type": "string" }
      }
    },
    "category_spending": {
      "type": "object",
      "required": ["category_id", "category_name", "amount_cents", "percent_of_expenses", "transaction_count"],
      "properties": {
        "category_id":         { "type": "integer" },
        "category_name":       { "type": "string" },
        "amount_cents":        { "type": "integer" },
        "percent_of_expenses": { "type": "integer" },
        "transaction_count":   { "type": "integer" }
      }
    },
    "shared_money": {
      "type": "object",
      "required": ["you_will_receive_cents", "you_owe_cents", "net_cents", "breakdown"],
      "properties": {
        "you_will_receive_cents": { "type": "integer" },
        "you_owe_cents":          { "type": "integer" },
        "net_cents":              { "type": "integer" },
        "breakdown": {
          "type": "array",
          "items": { "$ref": "#/definitions/debt_entry" }
        }
      }
    },
    "debt_entry": {
      "type": "object",
      "required": ["user_id", "name", "direction", "amount_cents"],
      "properties": {
        "user_id":      { "type": "integer" },
        "name":         { "type": ["string", "null"] },
        "direction":    { "type": "string", "enum": ["owes_you", "you_owe"] },
        "amount_cents": { "type": "integer" }
      }
    },
    "trend_month": {
      "type": "object",
      "required": ["month", "month_key", "income_cents", "expenses_cents"],
      "properties": {
        "month":          { "type": "string" },
        "month_key":      { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
        "income_cents":   { "type": "integer" },
        "expenses_cents": { "type": "integer" }
      }
    }
  }
}
