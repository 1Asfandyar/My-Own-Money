# .env.development.example — Copy to .env.development and fill in real values.
# .env.development is gitignored — NEVER commit real secrets.
#
# This file is sourced by .kamal/secrets.development at deploy time.
# It targets the staging / development server, not your local machine.
# For local development, use .env instead.

# ── Container registry ────────────────────────────────────────────────────────
KAMAL_REGISTRY_USERNAME=your-github-username
KAMAL_REGISTRY_PASSWORD=your-ghcr-personal-access-token   # needs write:packages scope

# ── Rails ─────────────────────────────────────────────────────────────────────
# Paste the contents of config/master.key here (single line, no quotes)
RAILS_MASTER_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Must match POSTGRES_USER / POSTGRES_PASSWORD below
DATABASE_URL=postgres://mom_user:staging-password@127.0.0.1:5432/mom_development

# ── Postgres accessory credentials ───────────────────────────────────────────
POSTGRES_USER=mom_user
POSTGRES_PASSWORD=staging-password

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Use a separate OAuth app/client for staging to avoid polluting production logs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Admin seed ────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@staging.yourdomain.com
ADMIN_PASSWORD=change-this-before-seeding
