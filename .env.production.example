# .env.production.example — Copy to .env.production and fill in real values.
# .env.production is gitignored — NEVER commit real secrets.
#
# This file is sourced by .kamal/secrets.production at deploy time.
# Kamal reads the secret variables listed in config/deploy.production.yml
# and injects them into the production container.

# ── Container registry ────────────────────────────────────────────────────────
KAMAL_REGISTRY_USERNAME=your-github-username
KAMAL_REGISTRY_PASSWORD=your-ghcr-personal-access-token   # needs write:packages scope

# ── Rails ─────────────────────────────────────────────────────────────────────
# Paste the contents of config/master.key here (single line, no quotes)
RAILS_MASTER_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Must match POSTGRES_USER / POSTGRES_PASSWORD below
DATABASE_URL=postgres://mom_user:strong-password@127.0.0.1:5432/mom_production

# ── Postgres accessory credentials ───────────────────────────────────────────
# Kamal passes these to the Postgres container on first boot.
# After first boot, changing them here does NOT change the DB password.
POSTGRES_USER=mom_user
POSTGRES_PASSWORD=strong-password

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Admin seed (used on first db:seed) ───────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-before-seeding
