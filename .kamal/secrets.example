# .kamal/secrets.example — copy to .kamal/secrets and fill in real values.
# .kamal/secrets is gitignored and NEVER committed.
#
# Kamal reads this file at deploy time and injects each variable as a Docker
# secret or environment variable (as declared in config/deploy.yml).

# ── Registry ───────────────────────────────────────────────────────────────────
KAMAL_REGISTRY_USERNAME=your-github-username
KAMAL_REGISTRY_PASSWORD=your-ghcr-personal-access-token   # needs write:packages scope

# ── Rails ─────────────────────────────────────────────────────────────────────
RAILS_MASTER_KEY=<paste contents of config/master.key>

# ── Database (app connection string) ─────────────────────────────────────────
DATABASE_URL=postgres://mom_user:strong-password@127.0.0.1:5432/mom_production

# ── Postgres accessory credentials ───────────────────────────────────────────
# Must match the DATABASE_URL values above.
POSTGRES_USER=mom_user
POSTGRES_PASSWORD=strong-password

# ── Google OAuth (optional — leave blank if not using Google login) ────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
