# .kamal/secrets.example — Template for the base secrets file.
#
# The base secrets file is NOT needed when you always deploy with -d production
# or -d development. Use the per-environment examples below instead.
#
# If you ever run `kamal deploy` WITHOUT a -d flag, Kamal reads this file only.
# In that case, copy to .kamal/secrets and fill in values.

. .env.production    # or swap to .env.development for staging
