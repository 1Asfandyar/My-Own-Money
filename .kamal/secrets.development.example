# .kamal/secrets.development.example — Template for development/staging secrets.
#
# Copy to .kamal/secrets.development (gitignored) before deploying.
# Kamal reads this when you run: kamal deploy -d development
#
# This file sources .env.development so you only maintain ONE secrets file
# per environment. All variables listed in config/deploy.development.yml
# under env.secret must be present in .env.development.

. .env.development
