# .kamal/secrets.production.example — Template for production secrets.
#
# Copy to .kamal/secrets.production (gitignored) before deploying.
# Kamal reads this when you run: kamal deploy -d production
#
# This file sources .env.production so you only maintain ONE secrets file
# per environment. All variables listed in config/deploy.production.yml
# under env.secret must be present in .env.production.

. .env.production
